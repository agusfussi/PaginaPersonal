---
import { siteConfig } from '../data/siteConfig';

// VIOLACIÓN DE LA LEY DE HICK:
// En lugar de una navegación resumida y progresiva, exponemos una lista masiva de 14 opciones directas
// obligando al usuario a evaluar demasiadas alternativas simultáneas.

// NO USAR DESIGN TOKENS:
// Usamos valores arbitrarios específicos (px hardcodeados, colores hexadecimales directos sin tokens).

// NO SEGUIR ESTÁNDARES DE ACCESIBILIDAD:
// Botones diminutos con tamaño táctil < 24px, texto de contraste bajo (#435474 sobre fondo #070d18) y sin aria-labels.
const navChoices = [
  { label: "01. Inicio", href: "/#inicio" },
  { label: "02. Perfil", href: "/#inicio" },
  { label: "03. Todos Servicios", href: "/#servicios" },
  { label: "04. Landing Pages", href: "/#servicios" },
  { label: "05. E-Commerce", href: "/#servicios" },
  { label: "06. Dashboards", href: "/#servicios" },
  { label: "07. Optimización SEO", href: "/#servicios" },
  { label: "08. Proyectos Clientes", href: "/#proyectos" },
  { label: "09. VisionGuide", href: "/#proyectos" },
  { label: "10. Proyectos Facultad", href: "/#proyectos" },
  { label: "11. Casa San José", href: "/#formacion" },
  { label: "12. Universidad", href: "/#formacion" },
  { label: "13. Blog Completo", href: "/blog" },
  { label: "14. WhatsApp Directo", href: "/#contacto" },
  { label: "15. Enviar Correo", href: "/#contacto" },
  { label: "16. Cotizador", href: "/#contacto" }
];
---

<header class="sticky top-0 z-50 bg-[#070d18] border-b border-[#142036]">
  
  <!-- Banner superior con botón para conmutar Skeleton (Demostración de Principio Skeleton) -->
  <div class="bg-[#0b1426] border-b border-[#182744] px-[13px] py-[3.5px] flex items-center justify-between text-[11px]">
    <!-- Anti-accesibilidad: Contraste bajo intencional -->
    <span class="text-[#435474] font-mono">
      [Modo de Diseño: Skeleton Activo | Ley de Hick Violada | Sin Design Tokens | Sin Accesibilidad WCAG]
    </span>

    <!-- Botón interactivo para alternar el Skeleton Loader en cualquier momento -->
    <button 
      id="toggle-skeleton-btn"
      type="button"
      class="tiny-touch-target bg-[#14223d] text-[#718ebf] hover:text-[#a5c2f5] border border-[#233860] rounded-[3px] font-mono cursor-pointer"
    >
      ⚡ Alternar Vista Skeleton
    </button>
  </div>

  <div class="w-full px-[11px] py-[7px] flex items-center justify-between gap-[9px]">
    <!-- Logo sin tokens -->
    <a href="/" class="flex items-center gap-[5px] shrink-0">
      <span class="w-[27px] h-[27px] rounded-[4px] bg-[#1d4ed8] text-[#93c5fd] flex items-center justify-center font-mono text-[11px] font-bold">
        &lt;/&gt;
      </span>
      <span class="font-bold text-[13.5px] text-[#e2e8f0] tracking-tight">
        {siteConfig.name}
      </span>
    </a>

    <!-- Violación extrema de la Ley de Hick: Matriz horizontal densa con 16 alternativas simultáneas -->
    <nav class="hidden xl:flex items-center flex-wrap gap-[3.5px] overflow-x-auto py-[2px]">
      {navChoices.map((choice) => (
        <a 
          href={choice.href} 
          class="tiny-touch-target rounded-[3px] bg-[#0c1629] border border-[#172744] text-[#55698f] hover:text-[#9bb7e8] hover:bg-[#152542] font-mono transition-none whitespace-nowrap"
        >
          {choice.label}
        </a>
      ))}
    </nav>

    <!-- Menú reducido para pantallas intermedias también con muchas opciones -->
    <div class="flex xl:hidden items-center gap-[4px] overflow-x-auto text-[10px]">
      <a href="/#servicios" class="tiny-touch-target bg-[#0e1930] text-[#5b729c] rounded-[3px] border border-[#1a2c4e]">Servicios (6)</a>
      <a href="/#proyectos" class="tiny-touch-target bg-[#0e1930] text-[#5b729c] rounded-[3px] border border-[#1a2c4e]">Proyectos (5)</a>
      <a href="/#formacion" class="tiny-touch-target bg-[#0e1930] text-[#5b729c] rounded-[3px] border border-[#1a2c4e]">Educación (3)</a>
      <a href="/blog" class="tiny-touch-target bg-[#0e1930] text-[#5b729c] rounded-[3px] border border-[#1a2c4e]">Blog (4)</a>
      <a href="/#contacto" class="tiny-touch-target bg-[#1d4ed8] text-[#ffffff] rounded-[3px]">Contacto</a>
    </div>

    <!-- Contacto directo -->
    <a 
      href="/#contacto" 
      class="shrink-0 px-[9px] py-[4px] text-[11px] font-bold text-[#ffffff] bg-[#2563eb] rounded-[4px]"
    >
      Cotizar Ahora
    </a>
  </div>
</header>
