---
import { siteConfig } from '../data/siteConfig';
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[#0b0f19]/80 border-b border-white/5 transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <span class="w-8 h-8 rounded-lg bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center font-mono font-bold text-white text-sm shadow-lg shadow-cyan-500/20 group-hover:scale-105 transition-transform">
        &lt;/&gt;
      </span>
      <div class="flex flex-col">
        <span class="font-bold tracking-tight text-white group-hover:text-cyan-400 transition-colors">
          {siteConfig.name}
        </span>
        <span class="text-[10px] text-slate-400 -mt-1 tracking-wider uppercase font-mono">
          Web Dev
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      <a href="/#servicios" class="px-3 py-1.5 text-sm font-medium text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
        Servicios
      </a>
      <a href="/#proyectos" class="px-3 py-1.5 text-sm font-medium text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
        Proyectos
      </a>
      <a href="/#formacion" class="px-3 py-1.5 text-sm font-medium text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
        Formación & Trayectoria
      </a>
      <a href="/blog" class="px-3 py-1.5 text-sm font-medium text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors flex items-center gap-1.5">
        Blog
        <span class="text-[10px] bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 px-1.5 py-0.5 rounded-full font-mono">Nuevo</span>
      </a>
      <a href="/#contacto" class="px-3 py-1.5 text-sm font-medium text-slate-300 hover:text-white hover:bg-white/5 rounded-lg transition-colors">
        Contacto
      </a>
    </nav>

    <!-- Right Action Button & Mobile Burger -->
    <div class="flex items-center gap-3">
      {siteConfig.availableForHire && (
        <span class="hidden sm:inline-flex items-center gap-1.5 text-xs font-medium text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-full">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          Disponible
        </span>
      )}
      
      <a 
        href="/#contacto"
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-xs font-semibold text-white bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 rounded-lg shadow-sm shadow-cyan-500/20 hover:shadow-cyan-500/40 transition-all hover:scale-[1.02] active:scale-[0.98]"
      >
        Cotizar Proyecto
      </a>

      <!-- Mobile menu button -->
      <button 
        id="mobile-menu-button"
        type="button" 
        class="md:hidden p-2 text-slate-400 hover:text-white hover:bg-white/5 rounded-lg transition-colors"
        aria-label="Abrir menú"
      >
        <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-white/5 bg-[#0b0f19]/95 px-4 pt-2 pb-6 space-y-2 backdrop-blur-lg">
    <a href="/#servicios" class="mobile-link block px-3 py-2 text-base font-medium text-slate-300 hover:text-white hover:bg-white/5 rounded-lg">
      Servicios
    </a>
    <a href="/#proyectos" class="mobile-link block px-3 py-2 text-base font-medium text-slate-300 hover:text-white hover:bg-white/5 rounded-lg">
      Proyectos
    </a>
    <a href="/#formacion" class="mobile-link block px-3 py-2 text-base font-medium text-slate-300 hover:text-white hover:bg-white/5 rounded-lg">
      Formación & Trayectoria
    </a>
    <a href="/blog" class="mobile-link block px-3 py-2 text-base font-medium text-slate-300 hover:text-white hover:bg-white/5 rounded-lg flex items-center justify-between">
      <span>Blog & Artículos</span>
      <span class="text-xs bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 px-2 py-0.5 rounded-full font-mono">Nuevo</span>
    </a>
    <a href="/#contacto" class="mobile-link block px-3 py-2 text-base font-medium text-slate-300 hover:text-white hover:bg-white/5 rounded-lg">
      Contacto
    </a>
    <div class="pt-3">
      <a 
        href="/#contacto"
        class="mobile-link w-full inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold text-white bg-gradient-to-r from-cyan-500 to-blue-600 rounded-lg shadow-sm"
      >
        Cotizar Proyecto
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (btn && menu && menuIcon && closeIcon) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      menuIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close when clicking any link
    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
