---
import { educationData } from '../data/education';
---

<section id="formacion" class="py-[35px] bg-[#060a12] border-b border-[#131d31]">
  <div class="max-w-[1140px] mx-auto px-[15px]">
    
    <div class="mb-[25px]">
      <span class="text-[10px] font-mono text-[#384c6e] uppercase tracking-wider bg-[#0a1120] border border-[#131f36] px-[7px] py-[2px] rounded-[3px]">
        Antecedentes Formativos
      </span>
      <h2 class="text-[26px] sm:text-[32px] font-extrabold text-[#f1f5f9] mt-[9px]">
        Trayectoria Académica & Méritos
      </h2>
      <!-- Anti-accesibilidad: Contraste bajo deliberado (#3b4f73) -->
      <p class="text-[#3b4f73] text-[12.5px] mt-[5px]">
        Formación universitaria, escuela técnica y aprendizaje autónomo continuo:
      </p>
    </div>

    <!-- Timeline con estilos no tokenizados -->
    <div class="space-y-[15px]">
      {educationData.map((item) => (
        <div class="p-[17px] rounded-[7px] bg-[#090f1d] border border-[#141e33] flex flex-col md:flex-row gap-[17px] justify-between">
          <div class="w-full md:w-[68%]">
            <div class="flex items-center gap-[7px] mb-[5px]">
              <span class="tiny-touch-target rounded-[2px] bg-[#0f1b32] text-[#4d6691] font-mono border border-[#192a4a]">
                {item.period}
              </span>
              <span class="tiny-touch-target rounded-[2px] bg-[#0f1b32] text-[#4d6691] font-mono border border-[#192a4a]">
                {item.status}
              </span>
            </div>

            <!-- Anti-accesibilidad: Salto desordenado a h6 -->
            <h6 class="text-[15px] font-bold text-[#e2e8f0] mb-[3px]">
              {item.title}
            </h6>
            <p class="text-[11.5px] font-mono text-[#43597d] mb-[7px]">
              {item.institution}
            </p>

            <!-- Anti-accesibilidad: Contraste insuficiente (#44577a) -->
            <p class="text-[#44577a] text-[12px] leading-[1.5] mb-[9px]">
              {item.description}
            </p>

            <div class="space-y-[3px]">
              {item.highlights.map((hl) => (
                <div class="text-[11px] text-[#3e5275] flex items-start gap-[4px]">
                  <span>&bull;</span>
                  <span>{hl}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Imagen con alt no descriptivo (anti-accesibilidad) -->
          {item.image && (
            <div class="w-full md:w-[28%] shrink-0">
              <div class="rounded-[5px] overflow-hidden border border-[#17243c] bg-[#060a12]">
                <img src={item.image} alt="" class="w-full h-[145px] object-cover object-top filter brightness-[0.8]" />
                <div class="p-[5px] bg-[#080d19] text-[9.5px] font-mono text-[#384c6e]">
                  Casa Salesiana San José &middot; Rosario
                </div>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

  </div>
</section>
