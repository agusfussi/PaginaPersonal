---
const educationItems = [
  {
    role: "Licenciatura en Negocios Digitales (2.º año en curso)",
    place: "Universidad Austral (Argentina)",
    period: "2025 — Presente",
    location: "Rosario, Argentina",
    description: "Cursando el segundo año de la carrera con todas las materias correspondientes al primer año completadas y aprobadas. Formación enfocada en la convergencia entre tecnología, desarrollo de soluciones digitales, innovación de negocios y análisis estratégico.",
    skills: ["Negocios Digitales", "Innovación Tecnológica", "Estrategia Digital", "Modelos de Negocio"]
  },
  {
    role: "Técnico en Informática — Egresado 2024",
    place: "Escuela Técnica San José (Rosario)",
    period: "2019 — 2024",
    location: "Rosario, Argentina",
    description: "Formación técnica de nivel superior con distinción académica como Escolta de la Bandera Nacional Argentina. Co-creador del proyecto asistencial 'VisionGuide' presentado con reconocimiento en la Expo-Bienal 2023.",
    skills: ["Técnico en Informática", "Escolta de la Bandera", "Hardware & Microcontroladores", "Programación C++ / Arduino", "Expo-Bienal 2023"],
    image: "/images/egresados-escolta.jpg"
  },
  {
    role: "B2 First Certificate in English (FCE - 2022)",
    place: "Cambridge Assessment English &middot; Cultural Inglesa",
    period: "2022",
    location: "Rosario, Argentina",
    description: "Certificación internacional de suficiencia en idioma inglés intermedio-avanzado, con capacidades de comunicación técnica, oral y escrita fluida para entornos globales y documentación técnica.",
    skills: ["Inglés Profesional B2", "Cambridge First Certificate", "Documentación Técnica", "Inglés Fluido"]
  }
];
---

<section id="educacion" class="w-11/12 max-w-4xl mx-auto my-28 px-4 sm:px-6" aria-labelledby="edu-sec-heading">
  <div class="text-center mb-16">
    <h2 id="edu-sec-heading" class="text-3xl md:text-4xl font-bold text-white tracking-tight">
      Educación & Formación
    </h2>
    <p class="mt-3 text-zinc-200 text-sm md:text-base max-w-lg mx-auto">
      Bases técnicas rigurosas y formación universitaria en innovación digital.
    </p>
  </div>

  <div class="relative border-l-2 border-zinc-700 ml-3 md:ml-10">
    {educationItems.map((item) => (
      <article class="relative pl-8 pb-16 md:pb-20 last:pb-0 group">
        
        <!-- Timeline dot -->
        <div class="absolute -left-[9px] top-2 h-4 w-4 rounded-full bg-zinc-200 border-4 border-[#09090b]" aria-hidden="true"></div>

        <div class="flex flex-col gap-1 mb-4">
          <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-1 md:gap-4">
            <h3 class="text-xl md:text-2xl font-bold text-white leading-tight">
              <span class="font-normal text-zinc-300">{item.place}</span> — {item.role}
            </h3>
            <span class="text-xs md:text-sm font-mono text-zinc-300 whitespace-nowrap">
              {item.period}
            </span>
          </div>

          <p class="text-xs text-zinc-300 font-medium flex items-center gap-1.5 font-mono" set:html={`
            <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            ${item.location}
          `} />
        </div>

        <div class="grid md:grid-cols-[1fr_auto] gap-6 items-start">
          <div class="space-y-4">
            <p class="text-zinc-200 leading-relaxed text-sm md:text-base">
              {item.description}
            </p>

            <ul class="flex flex-wrap gap-2">
              {item.skills.map((skill) => (
                <li class="text-[10px] md:text-xs font-mono px-2.5 py-1 border border-zinc-700 text-zinc-200 rounded-md bg-zinc-900">
                  {skill}
                </li>
              ))}
            </ul>
          </div>

          {item.image && (
            <div class="hidden md:block relative w-24 h-24 rounded-xl overflow-hidden border border-zinc-700 bg-zinc-900 shrink-0 group">
              <img 
                src={item.image} 
                alt={`Distinción de Agustín Fussi en ${item.place}`} 
                class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 scale-105 group-hover:scale-100" 
              />
            </div>
          )}
        </div>

      </article>
    ))}
  </div>
</section>
