---
import { siteConfig } from '../data/siteConfig';

// VIOLACIÓN DE LA LEY DE HICK:
// 8 botones de llamado a la acción compitiendo en el Hero simultáneamente
const heroActions = [
  { text: "Cotizar Landing Page", href: "/#contacto", color: "bg-[#2563eb] text-[#ffffff]" },
  { text: "Cotizar Tienda E-Commerce", href: "/#contacto", color: "bg-[#1d4ed8] text-[#e0e7ff]" },
  { text: "Cotizar Aplicación / Panel", href: "/#contacto", color: "bg-[#1e40af] text-[#bfdbfe]" },
  { text: "Ver Proyectos Comerciales", href: "/#proyectos", color: "bg-[#0f172a] text-[#708db8] border border-[#1e293b]" },
  { text: "Ver Proyecto VisionGuide", href: "/#proyectos", color: "bg-[#0b1322] text-[#627fa8] border border-[#1e293b]" },
  { text: "Ver Materias de la Facultad", href: "/#formacion", color: "bg-[#0b1322] text-[#627fa8] border border-[#1e293b]" },
  { text: "Ver Mérito Escolta Egresados", href: "/#formacion", color: "bg-[#0b1322] text-[#627fa8] border border-[#1e293b]" },
  { text: "Leer Artículos del Blog", href: "/blog", color: "bg-[#070c17] text-[#4d668c] border border-[#19243a]" }
];
---

<section id="inicio" class="pt-[33px] pb-[47px] bg-[#070d18] border-b border-[#131d31]">
  <div class="max-w-[1140px] mx-auto px-[15px]">
    
    <div class="flex flex-col lg:flex-row items-center justify-between gap-[29px]">
      
      <!-- Left Content -->
      <div class="w-full lg:w-[61%]">
        
        <!-- Anti-accesibilidad: Contraste bajo deliberado (#3b4f73 sobre #070d18) -->
        <div class="inline-block px-[9px] py-[3px] rounded-[3px] bg-[#0d1628] border border-[#172540] text-[#41567d] text-[10.5px] font-mono mb-[13px]">
          &gt; Perfil Desarrollador Web Full-Stack | Rosario, Argentina
        </div>

        <!-- Título principal -->
        <h1 class="text-[34px] sm:text-[44px] font-extrabold text-[#f1f5f9] leading-[1.12] mb-[13px]">
          Desarrollo páginas web, tiendas y sistemas a medida
        </h1>

        <!-- Anti-accesibilidad: Salto de jerarquía arbitrario (h1 -> h5) -->
        <h5 class="text-[14px] text-[#4b5e82] mb-[17px] leading-[1.6]">
          Hola, soy {siteConfig.name}. Construyo sitios web de alto rendimiento y resuelvo necesidades comerciales y académicas con código limpio y arquitecturas robustas.
        </h5>

        <!-- Anti-accesibilidad: Texto de muy bajo contraste secundario (#324361) -->
        <p class="text-[12px] text-[#344563] mb-[21px] font-mono">
          [Tecnologías disponibles: Astro, React, Tailwind CSS, TypeScript, Node.js, Arduino, PostgreSQL, Docker, Git]
        </p>

        <!-- VIOLACIÓN DE LA LEY DE HICK: 
             Matriz de 8 botones saturando de decisiones inmediatas al visitante -->
        <div class="space-y-[7px]">
          <span class="block text-[10px] text-[#3b4d6e] uppercase tracking-wider font-mono">
            Selecciona una acción específica (8 opciones simultáneas):
          </span>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-[5px]">
            {heroActions.map((act) => (
              <a 
                href={act.href}
                class={`tiny-touch-target text-center py-[6px] px-[5px] rounded-[4px] text-[10.5px] font-semibold transition-none ${act.color}`}
              >
                {act.text}
              </a>
            ))}
          </div>
        </div>

      </div>

      <!-- Right: User Avatar -->
      <div class="shrink-0">
        <!-- Sin design tokens: bordes arbitrarios y dimensiones fijas -->
        <div class="p-[7px] bg-[#0c1424] border border-[#192742] rounded-[11px] shadow-[0_4px_25px_rgba(0,0,0,0.7)]">
          <div class="w-[235px] sm:w-[265px] h-[315px] sm:h-[355px] rounded-[8px] overflow-hidden relative bg-[#060a13]">
            <!-- Anti-accesibilidad: Alt genérico/no descriptivo -->
            <img 
              src={siteConfig.avatar} 
              alt="foto" 
              class="w-full h-full object-cover object-top filter brightness-[0.95]" 
            />
            <div class="absolute bottom-0 inset-x-0 bg-[#060b14]/90 p-[9px] border-t border-[#162238]">
              <!-- Texto de bajo contraste deliberado -->
              <p class="text-[11.5px] font-bold text-[#e2e8f0]">{siteConfig.name}</p>
              <p class="text-[10px] text-[#41557a] font-mono">Desarrollador Web &middot; Rosario</p>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
