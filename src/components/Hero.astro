---
import { siteConfig } from '../data/siteConfig';
---

<section id="hero" class="relative min-h-[75vh] flex flex-col items-center justify-center text-center px-6 overflow-hidden">
  
  <!-- Subtle ambient glow background inspired by Galo Berlini -->
  <div aria-hidden="true" class="pointer-events-none absolute -inset-[10%] opacity-40">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-zinc-700/20 via-zinc-500/10 to-transparent blur-[120px] rounded-full"></div>
    <div class="absolute bottom-10 left-1/3 w-[400px] h-[250px] bg-zinc-600/10 blur-[100px] rounded-full"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
    
    <!-- Location & Status Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-zinc-800 bg-zinc-900/60 text-zinc-400 text-xs font-mono mb-8 backdrop-blur-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Rosario, Argentina &middot; Negocios Digitales & Desarrollo</span>
    </div>

    <!-- Main Title: Agustín Fussi (sin clipping en la g) -->
    <h1 class="text-5xl sm:text-7xl md:text-8xl font-black tracking-tight text-white leading-tight pb-2">
      Agustín Fussi
    </h1>

    <!-- Subtitle: Transformación Digital -->
    <p class="mt-4 text-2xl sm:text-3xl md:text-4xl text-zinc-300 font-light">
      Transformación Digital
    </p>

    <!-- Punchy statement -->
    <p class="mt-5 max-w-xl text-base sm:text-lg text-zinc-400 leading-relaxed font-normal">
      Resolviendo problemas reales con código confiable, buenas prácticas y tecnologías web modernas.
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto">
      <a 
        href="/#proyectos" 
        class="w-full sm:w-auto px-7 py-3 rounded-md bg-white text-zinc-950 font-bold hover:bg-zinc-200 transition-all flex items-center justify-center gap-2 text-sm shadow-lg shadow-white/5"
      >
        <span>Ver Proyectos</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>

      <a 
        href="/sobre-mi" 
        class="w-full sm:w-auto px-7 py-3 rounded-md border border-zinc-700 text-zinc-200 font-medium hover:bg-zinc-800/80 transition-all flex items-center justify-center gap-2 text-sm"
      >
        <span>Sobre Mí</span>
        <span>→</span>
      </a>
    </div>

  </div>

</section>
