---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section id="blog-preview" class="py-20 border-t border-white/5 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12">
      <div>
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest bg-cyan-950/60 border border-cyan-500/20 px-3 py-1 rounded-full">
          Publicaciones & Bitácora
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 tracking-tight">
          Últimos artículos del blog
        </h2>
        <p class="text-slate-400 mt-2 text-base max-w-xl">
          Comparto aprendizajes sobre desarrollo web, proyectos de la facultad y buenas prácticas para negocios y estudiantes.
        </p>
      </div>

      <a 
        href="/blog" 
        class="mt-4 sm:mt-0 inline-flex items-center gap-2 text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition-colors"
      >
        <span>Ver todos los artículos</span>
        <span>→</span>
      </a>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {sortedPosts.map((post) => (
        <a 
          href={`/blog/${post.id}/`}
          class="group rounded-2xl bg-slate-900/40 border border-white/5 hover:border-cyan-500/30 p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-cyan-950/20 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between text-xs text-slate-400 font-mono mb-3">
              <span class="px-2 py-0.5 rounded bg-slate-800 text-cyan-300 border border-white/5">
                {post.data.category}
              </span>
              <span>{post.data.readTime}</span>
            </div>

            <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors line-clamp-2 mt-2 leading-snug">
              {post.data.title}
            </h3>

            <p class="text-slate-400 text-sm mt-3 line-clamp-3 leading-relaxed">
              {post.data.description}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs text-slate-400">
            <span>
              {new Date(post.data.pubDate).toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
            <span class="text-cyan-400 font-semibold group-hover:translate-x-1 transition-transform">
              Leer artículo →
            </span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
