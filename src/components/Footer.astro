---
import { siteConfig } from '../data/siteConfig';

const currentYear = new Date().getFullYear();
---

<footer id="contacto" class="w-11/12 max-w-4xl mx-auto mt-28 mb-16 px-4 sm:px-6" aria-labelledby="contact-heading">
  <!-- Divider -->
  <div class="w-full h-px bg-zinc-800 mb-16" aria-hidden="true"></div>

  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-10">
    
    <!-- Left: Call to action & email -->
    <div class="space-y-3">
      <h2 id="contact-heading" class="text-3xl md:text-4xl font-bold tracking-tight text-white">
        Trabajemos juntos.
      </h2>
      <p class="text-zinc-200 text-sm md:text-base font-light">
        Escríbeme para proyectos, consultas o nuevas oportunidades:
      </p>
      <div>
        <a 
          href={`mailto:${siteConfig.email}`} 
          class="text-xl md:text-2xl font-mono font-medium text-white hover:text-zinc-200 transition-colors border-b-2 border-zinc-600 hover:border-white pb-0.5 inline-block focus:outline-none focus:ring-2 focus:ring-zinc-400 rounded-sm"
          aria-label={`Enviar correo a ${siteConfig.email}`}
        >
          {siteConfig.email}
        </a>
      </div>
    </div>

    <!-- Right: Only LinkedIn and GitHub as requested -->
    <div class="flex items-center gap-6 pt-2">
      <a 
        href={siteConfig.linkedin} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center gap-2 text-sm font-medium text-zinc-200 hover:text-white transition-colors group focus:outline-none focus:ring-2 focus:ring-zinc-400 rounded-md p-1"
        aria-label="Perfil de LinkedIn de Agustín Fussi"
      >
        <svg class="w-5 h-5 text-zinc-300 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
        <span>LinkedIn</span>
      </a>

      <a 
        href={siteConfig.github} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="flex items-center gap-2 text-sm font-medium text-zinc-200 hover:text-white transition-colors group focus:outline-none focus:ring-2 focus:ring-zinc-400 rounded-md p-1"
        aria-label="Perfil de GitHub de Agustín Fussi"
      >
        <svg class="w-5 h-5 text-zinc-300 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub</span>
      </a>
    </div>

  </div>

  <!-- Bottom info -->
  <div class="mt-16 pt-8 border-t border-zinc-800 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-mono text-zinc-300">
    <p>&copy; {currentYear} Agustín Fussi. Todos los derechos reservados.</p>
    <div class="flex items-center gap-3">
      <span>Rosario, AR</span>
      <span aria-hidden="true">&middot;</span>
      <span>GMT-3</span>
    </div>
  </div>
</footer>
