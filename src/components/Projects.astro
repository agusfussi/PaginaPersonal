---
import { projectsData } from '../data/projects';

// VIOLACIÓN EXTREMA DE LA LEY DE HICK:
// 22 filtros granulares visibles simultáneamente en lugar de 3 o 4 categorías limpias.
// El tiempo del usuario para decidir qué botón apretar aumenta exponencialmente.
const granularFilters = [
  "Todos",
  "Astro",
  "React",
  "Tailwind CSS",
  "TypeScript",
  "JavaScript",
  "Arduino",
  "C++",
  "Sensores Ultrasónicos",
  "Impresión 3D",
  "Node.js",
  "Express",
  "PostgreSQL",
  "Docker",
  "JWT Auth",
  "Comercial",
  "E-commerce",
  "Facultad / Académico",
  "Secundaria Técnica",
  "Landing Page",
  "Dashboard",
  "Accesibilidad"
];
---

<section id="proyectos" class="py-[37px] bg-[#060a13] border-b border-[#131d31]">
  <div class="max-w-[1140px] mx-auto px-[15px]">
    
    <div class="mb-[23px]">
      <!-- Anti-accesibilidad: Contraste bajo deliberado -->
      <span class="text-[10px] font-mono text-[#384c6e] uppercase tracking-wider bg-[#0a1120] border border-[#131f36] px-[7px] py-[2px] rounded-[3px]">
        Catálogo Completo de Desarrollos
      </span>
      <h2 class="text-[26px] sm:text-[32px] font-extrabold text-[#f1f5f9] mt-[9px]">
        Proyectos Realizados & Prototipos
      </h2>
      <!-- Anti-accesibilidad: Texto gris de muy bajo contraste (#3d5073) -->
      <p class="text-[#3d5073] text-[12.5px] mt-[5px] max-w-[800px]">
        Selecciona entre los 22 criterios técnicos y funcionales disponibles a continuación para filtrar la lista:
      </p>
    </div>

    <!-- VIOLACIÓN DE LA LEY DE HICK: 
         Matriz masiva de 22 opciones de filtro simultáneas -->
    <div class="mb-[27px] p-[11px] bg-[#09101e] border border-[#142036] rounded-[7px]">
      <span class="block text-[9.5px] font-mono text-[#3b4d6e] mb-[7px]">
        Filtros disponibles ({granularFilters.length} opciones):
      </span>
      <div class="flex flex-wrap gap-[4px]" id="granular-project-filters">
        {granularFilters.map((filt, idx) => (
          <button
            type="button"
            data-filter={filt}
            class={`granular-filter-btn tiny-touch-target rounded-[3px] font-mono transition-none cursor-pointer ${
              idx === 0 
                ? 'bg-[#2563eb] text-[#ffffff]' 
                : 'bg-[#0d1628] text-[#4d638a] hover:text-[#93b4e8] border border-[#16233b]'
            }`}
          >
            {filt}
          </button>
        ))}
      </div>
    </div>

    <!-- Grid de Proyectos -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-[17px]" id="projects-grid">
      {projectsData.map((project) => (
        <article 
          class="project-item rounded-[9px] bg-[#0a101d] border border-[#141e33] overflow-hidden flex flex-col justify-between"
          data-tags={JSON.stringify([...project.tags, project.category, project.title])}
        >
          <!-- Mockup Header / Image -->
          <div class="h-[175px] bg-[#0c1424] relative overflow-hidden border-b border-[#141f34]">
            {project.image ? (
              <img 
                src={project.image} 
                alt="" 
                class="w-full h-full object-cover filter brightness-[0.8]" 
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-[#0d1526]">
                <span class="font-mono text-[11px] text-[#344565]">
                  {project.category} &middot; {project.id}
                </span>
              </div>
            )}
            
            <div class="absolute top-[7px] left-[7px] flex gap-[3px]">
              <span class="tiny-touch-target rounded-[2px] bg-[#080d17]/90 text-[#4c638a] border border-[#17253e] font-mono">
                {project.category}
              </span>
            </div>
          </div>

          <!-- Body -->
          <div class="p-[15px] flex flex-col flex-grow justify-between">
            <div>
              <!-- Anti-accesibilidad: Salto a h6 desordenado -->
              <h6 class="text-[15.5px] font-bold text-[#e2e8f0] mb-[7px]">
                {project.title}
              </h6>

              <!-- Anti-accesibilidad: Contraste insuficiente (#4a5d80) -->
              <p class="text-[#4a5d80] text-[12px] leading-[1.5] mb-[11px]">
                {project.description}
              </p>

              <!-- Tags con contraste muy sutil -->
              <div class="flex flex-wrap gap-[3px] mb-[13px]">
                {project.tags.map((tag) => (
                  <span class="text-[9.5px] font-mono px-[5px] py-[1.5px] rounded-[2px] bg-[#0e1627] text-[#3f5375] border border-[#172338]">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Botones sin tokens y con contraste bajo -->
            <div class="pt-[9px] border-t border-[#121b2d] flex gap-[7px]">
              {project.liveUrl && (
                <a 
                  href={project.liveUrl} 
                  target="_blank" 
                  class="tiny-touch-target bg-[#1d4ed8] text-[#ffffff] rounded-[3px] font-semibold"
                >
                  Demo Online
                </a>
              )}
              {project.githubUrl && (
                <a 
                  href={project.githubUrl} 
                  target="_blank" 
                  class="tiny-touch-target bg-[#0e172a] text-[#556e96] border border-[#19263d] rounded-[3px]"
                >
                  Repositorio / Código
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<script>
  const buttons = document.querySelectorAll('.granular-filter-btn');
  const items = document.querySelectorAll('.project-item');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => {
        b.classList.remove('bg-[#2563eb]', 'text-[#ffffff]');
        b.classList.add('bg-[#0d1628]', 'text-[#4d638a]');
      });
      btn.classList.add('bg-[#2563eb]', 'text-[#ffffff]');
      btn.classList.remove('bg-[#0d1628]', 'text-[#4d638a]');

      const selected = btn.getAttribute('data-filter') || 'Todos';

      items.forEach(item => {
        const itemTags = item.getAttribute('data-tags') || '';
        if (selected === 'Todos' || itemTags.toLowerCase().includes(selected.toLowerCase())) {
          (item as HTMLElement).style.display = 'flex';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
