---
import { projectsData } from '../data/projects';

const categories = ["Todos", "Comercial", "Aplicación Web", "E-commerce", "Facultad / Académico"];
---

<section id="proyectos" class="py-20 border-t border-white/5 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest bg-cyan-950/60 border border-cyan-500/20 px-3 py-1 rounded-full">
          Portfolio de Trabajos
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 tracking-tight">
          Proyectos destacados & Desarrollos
        </h2>
        <p class="text-slate-400 mt-2 text-base max-w-xl">
          Explora proyectos comerciales para clientes, desarrollos propios y soluciones tecnológicas creadas durante mi formación en la facultad y secundaria técnica.
        </p>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap gap-2 mt-6 md:mt-0" id="project-filters">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat}
            class={`filter-btn px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${
              idx === 0 
                ? 'bg-cyan-500 text-white shadow-sm shadow-cyan-500/30' 
                : 'bg-slate-900/80 text-slate-400 hover:text-white border border-white/5 hover:border-white/20'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="projects-container">
      {projectsData.map((project) => (
        <article 
          class="project-card group rounded-2xl bg-slate-900/40 border border-white/5 hover:border-cyan-500/30 overflow-hidden transition-all duration-300 hover:shadow-2xl hover:shadow-cyan-950/20 flex flex-col justify-between"
          data-project-category={project.category}
        >
          <!-- Mockup Top Bar Visual / Image -->
          <div class={`h-44 sm:h-52 bg-gradient-to-br ${project.gradient} p-4 sm:p-5 flex flex-col justify-between border-b border-white/5 relative overflow-hidden`}>
            
            {project.image ? (
              <>
                <img 
                  src={project.image} 
                  alt={project.title} 
                  class="absolute inset-0 w-full h-full object-cover object-center filter brightness-[0.75] contrast-[1.05] group-hover:scale-105 group-hover:brightness-[0.9] transition-all duration-500" 
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>
              </>
            ) : null}

            <!-- Simulated Browser / Terminal bar -->
            <div class="relative z-10 flex items-center justify-between">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                <span class="ml-2 px-2 py-0.5 rounded text-[10px] font-mono bg-black/60 backdrop-blur-sm text-slate-300 border border-white/10">
                  {project.category}
                </span>
              </div>
              {project.featured && (
                <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded-full bg-cyan-400 text-slate-950 shadow-sm">
                  ★ Destacado
                </span>
              )}
            </div>

            <!-- Visual Title or Code simulation inside mockup -->
            <div class="relative z-10 mt-auto">
              <span class="text-xs font-mono text-cyan-300 opacity-90 drop-shadow">
                {project.mockupType === 'code' ? '>_ git commit -m "build project"' : project.mockupType === 'hardware' ? '⚡ Arduino / Firmware & 3D Print' : 'https://' + project.id + '.dev'}
              </span>
              <h4 class="text-base sm:text-lg font-bold text-white mt-1 line-clamp-1 group-hover:text-cyan-300 transition-colors drop-shadow">
                {project.title}
              </h4>
            </div>
          </div>

          <!-- Card Content Body -->
          <div class="p-6 sm:p-7 flex flex-col flex-grow justify-between">
            <div>
              <p class="text-slate-300 text-sm leading-relaxed mb-4">
                {project.description}
              </p>

              <!-- Metrics if any -->
              {project.metrics && project.metrics.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-4">
                  {project.metrics.map((metric) => (
                    <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-emerald-950/40 text-emerald-300 border border-emerald-500/20">
                      ✓ {metric}
                    </span>
                  ))}
                </div>
              )}

              <!-- Tech Tags -->
              <div class="flex flex-wrap gap-1.5 mb-6">
                {project.tags.map((tag) => (
                  <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-slate-800/80 text-slate-300 border border-white/5">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Action Links -->
            <div class="flex items-center gap-4 pt-4 border-t border-white/5 mt-auto">
              {project.liveUrl && (
                <a 
                  href={project.liveUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-white bg-cyan-600 hover:bg-cyan-500 px-3.5 py-1.5 rounded-lg transition-colors"
                >
                  <span>Ver Sitio Online</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
              )}

              {project.githubUrl && (
                <a 
                  href={project.githubUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-300 hover:text-white px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                  <span>Código / Docs</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('.project-card');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => {
        b.classList.remove('bg-cyan-500', 'text-white', 'shadow-sm', 'shadow-cyan-500/30');
        b.classList.add('bg-slate-900/80', 'text-slate-400');
      });
      btn.classList.add('bg-cyan-500', 'text-white', 'shadow-sm', 'shadow-cyan-500/30');
      btn.classList.remove('bg-slate-900/80', 'text-slate-400');

      const selectedCategory = btn.getAttribute('data-category');

      projectCards.forEach(card => {
        const cardCategory = card.getAttribute('data-project-category');
        if (selectedCategory === 'Todos' || cardCategory === selectedCategory) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
