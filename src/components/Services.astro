---
const services = [
  {
    icon: `<svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    title: "Landing Pages de Alta Conversión",
    description: "Páginas de aterrizaje diseñadas con un solo objetivo: convertir visitantes en clientes. Carga instantánea, diseño llamativo y llamados a la acción irresistibles.",
    benefits: ["Carga en menos de 1 segundo", "Botón directo a WhatsApp / Formulario", "Adaptable a todos los dispositivos", "Optimizada para pauta y redes"]
  },
  {
    icon: `<svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`,
    title: "Sitios Web Corporativos e Institucionales",
    description: "Transmite solidez y profesionalismo con una página web moderna para tu empresa, estudio, consultorio o marca personal.",
    benefits: ["Diseño 100% a medida de tu marca", "Estructura multi-sección intuitiva", "SEO para aparecer en Google", "Panel de administración o fácil edición"]
  },
  {
    icon: `<svg class="w-6 h-6 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>`,
    title: "Tiendas Online & Catálogos Digitales",
    description: "Muestra tus productos las 24 horas del día. Desde catálogos interactivos con pedidos por WhatsApp hasta e-commerce con pasarelas de pago.",
    benefits: ["Buscador y filtros por categoría", "Carrito de compras intuitivo", "Cierre de ventas sin comisiones abusivas", "Gestión sencilla de stock"]
  },
  {
    icon: `<svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`,
    title: "Aplicaciones Web & Paneles de Control",
    description: "Sistemas a medida para automatizar operaciones de negocio: registros, dashboards, CRUDs y plataformas interactivas.",
    benefits: ["Bases de datos seguras y escalables", "Autenticación y roles de usuario", "Reportes y visualización de datos", "Integración con APIs externas"]
  },
  {
    icon: `<svg class="w-6 h-6 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>`,
    title: "Rediseño & Optimización de Velocidad (SEO)",
    description: "¿Tienes un sitio web lento o anticuado? Lo renovamos visualmente y multiplicamos su velocidad de carga para que no pierdas ventas.",
    benefits: ["Puntuación 90+ en Google PageSpeed", "Mejora de posicionamiento SEO", "Adaptación completa para móviles", "Reducción de tasa de rebote"]
  },
  {
    icon: `<svg class="w-6 h-6 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    title: "Mantenimiento & Soporte Continuo",
    description: "Despreocúpate de la parte técnica. Me encargo de mantener tu sitio actualizado, seguro y funcionando sin interrupciones.",
    benefits: ["Copias de seguridad regulares", "Soporte técnico directo y rápido", "Actualización de contenidos y ofertas", "Monitoreo de seguridad"]
  }
];

const steps = [
  {
    step: "01",
    title: "Charla & Diagnóstico",
    desc: "Conversamos sobre tus necesidades, tu público objetivo y los objetivos comerciales de tu web."
  },
  {
    step: "02",
    title: "Propuesta & Diseño",
    desc: "Definimos la arquitectura, el diseño visual y las funcionalidades clave antes de programar."
  },
  {
    step: "03",
    title: "Desarrollo & Pruebas",
    desc: "Escribo código limpio, realizo pruebas de velocidad y adapto la interfaz a todos los dispositivos."
  },
  {
    step: "04",
    title: "Lanzamiento & Éxito",
    desc: "Ponemos la web online, conectamos tu dominio y te enseño cómo aprovecharla al máximo."
  }
];
---

<section id="servicios" class="py-20 border-t border-white/5 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest bg-cyan-950/60 border border-cyan-500/20 px-3 py-1 rounded-full">
        Servicios Profesionales
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 tracking-tight">
        Soluciones web pensadas para generar resultados reales
      </h2>
      <p class="text-slate-400 mt-4 text-base">
        No vendo plantillas genéricas. Cada proyecto se programa a medida utilizando tecnología de vanguardia para asegurar máxima velocidad, seguridad y ventas.
      </p>
    </div>

    <!-- Services Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service) => (
        <div class="group relative rounded-2xl p-7 bg-slate-900/40 border border-white/5 hover:border-cyan-500/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-cyan-950/20 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-slate-800/80 border border-white/10 flex items-center justify-center mb-6 group-hover:scale-110 group-hover:bg-cyan-950/50 group-hover:border-cyan-500/40 transition-all">
              <Fragment set:html={service.icon} />
            </div>
            
            <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors">
              {service.title}
            </h3>
            
            <p class="text-slate-400 text-sm mt-3 leading-relaxed">
              {service.description}
            </p>

            <ul class="mt-6 space-y-2 border-t border-white/5 pt-4">
              {service.benefits.map((benefit) => (
                <li class="flex items-center gap-2 text-xs text-slate-300">
                  <svg class="w-4 h-4 text-cyan-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>{benefit}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-8 pt-4">
            <a 
              href="/#contacto" 
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-cyan-400 hover:text-cyan-300 group-hover:translate-x-1 transition-transform"
            >
              Consultar por este servicio 
              <span>→</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Process Workflow Section -->
    <div class="mt-24 p-8 sm:p-10 rounded-3xl bg-gradient-to-b from-slate-900/60 to-slate-950/60 border border-white/10">
      <div class="text-center max-w-xl mx-auto mb-10">
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest">Metodología Clara</span>
        <h3 class="text-2xl font-bold text-white mt-2">¿Cómo trabajamos juntos?</h3>
        <p class="text-slate-400 text-sm mt-2">Un proceso transparente paso a paso sin sorpresas ni demoras innecesarias.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {steps.map((st) => (
          <div class="relative p-5 rounded-xl bg-slate-900/40 border border-white/5">
            <span class="text-3xl font-extrabold font-mono text-cyan-500/30">{st.step}</span>
            <h4 class="text-base font-bold text-white mt-2">{st.title}</h4>
            <p class="text-xs text-slate-400 mt-2 leading-relaxed">{st.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
