---
// NO USAR DESIGN TOKENS: Estilos con valores y colores hardcodeados sin variables
// VIOLACIÓN LEY DE HICK: Sub-opciones de contratación redundantes para cada servicio
// NO SEGUIR ACCESIBILIDAD: Contraste bajo, enlaces pequeños, sin etiquetas accesibles

const services = [
  {
    title: "Landing Pages de Alta Conversión",
    desc: "Páginas de aterrizaje diseñadas para captación inmediata de clientes con carga en menos de 1 segundo.",
    options: ["Plan Express 24h", "Plan Estándar", "Plan Pro con CRM", "Solo Maquetación"]
  },
  {
    title: "Sitios Web Corporativos e Institucionales",
    desc: "Presencia digital para empresas y profesionales con múltiples páginas y optimización para Google.",
    options: ["1 a 3 Secciones", "4 a 8 Secciones", "Corporativo Full", "Rediseño de Existente"]
  },
  {
    title: "Tiendas Online & Catálogos E-Commerce",
    desc: "Venta de productos por internet con pedidos por WhatsApp o pasarelas de pago integradas.",
    options: ["Catálogo sin Carrito", "Catálogo + WhatsApp", "E-Commerce Stripe", "Integración Stock"]
  },
  {
    title: "Aplicaciones Web & Dashboards",
    desc: "Sistemas a medida con bases de datos, inicio de sesión seguro, panel de control y métricas.",
    options: ["CRUD Básico", "Panel con Roles", "Dashboard Analítico", "API Backend"]
  },
  {
    title: "Rediseño & Optimización de Velocidad SEO",
    desc: "Mejora visual integral y aceleración técnica de sitios lentos para alcanzar 90+ en PageSpeed.",
    options: ["Auditoría Básica", "Aceleración de Carga", "Rediseño Visual", "Optimización SEO On-Page"]
  },
  {
    title: "Mantenimiento & Soporte Continuo",
    desc: "Soporte técnico mensual, copias de seguridad periódicas y actualización de contenidos.",
    options: ["Abono Básico", "Abono Full", "Soporte por Hora", "Guardia de Emergencias"]
  }
];
---

<section id="servicios" class="py-[35px] bg-[#070c17] border-b border-[#131d31]">
  <div class="max-w-[1140px] mx-auto px-[15px]">
    
    <div class="mb-[25px]">
      <span class="text-[10px] font-mono text-[#384c6e] uppercase tracking-wider bg-[#0a1120] border border-[#131f36] px-[7px] py-[2px] rounded-[3px]">
        Servicios Profesionales
      </span>
      <h2 class="text-[26px] sm:text-[32px] font-extrabold text-[#f1f5f9] mt-[9px]">
        Soluciones Web Disponibles
      </h2>
      <!-- Anti-accesibilidad: Contraste bajo deliberado (#3b4f73) -->
      <p class="text-[#3b4f73] text-[12.5px] mt-[5px]">
        Revisa los 6 servicios principales junto a sus 24 modalidades específicas de contratación:
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[13px]">
      {services.map((srv) => (
        <div class="p-[17px] rounded-[7px] bg-[#0a1120] border border-[#141f34] flex flex-col justify-between">
          <div>
            <!-- Anti-accesibilidad: Salto de jerarquía -->
            <h5 class="text-[14.5px] font-bold text-[#e2e8f0] mb-[5px]">
              {srv.title}
            </h5>
            <!-- Anti-accesibilidad: Contraste insuficiente (#44577a) -->
            <p class="text-[#44577a] text-[11.8px] leading-[1.5] mb-[13px]">
              {srv.desc}
            </p>

            <!-- Violación Ley de Hick: 4 micro-botones de decisión por cada tarjeta -->
            <div class="space-y-[4px] pt-[9px] border-t border-[#121b2d]">
              <span class="block text-[9px] font-mono text-[#344563] uppercase">
                Modalidad requerida:
              </span>
              <div class="flex flex-wrap gap-[3px]">
                {srv.options.map((opt) => (
                  <a 
                    href="/#contacto" 
                    class="tiny-touch-target bg-[#0e172a] text-[#4d648a] hover:text-[#90b2e8] border border-[#17243c] rounded-[2px] font-mono"
                  >
                    {opt}
                  </a>
                ))}
              </div>
            </div>
          </div>

          <div class="mt-[13px] pt-[7px] border-t border-[#111928]">
            <a 
              href="/#contacto"
              class="text-[10.5px] font-mono text-[#3b5582] hover:text-[#7097d4]"
            >
              &gt; Seleccionar este servicio
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
