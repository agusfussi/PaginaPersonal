---
import { siteConfig } from '../data/siteConfig';

const whatsappEncoded = encodeURIComponent("¡Hola! Vi tu página web y me gustaría consultarte por el desarrollo de un proyecto.");
---

<section id="contacto" class="py-20 border-t border-white/5 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left Column: Info & Pitch -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div>
          <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest bg-cyan-950/60 border border-cyan-500/20 px-3 py-1 rounded-full">
            Iniciemos una conversación
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-4 tracking-tight">
            ¿Tienes una idea o necesitas una página web?
          </h2>
          <p class="text-slate-300 mt-4 text-base leading-relaxed">
            Hablemos sobre tu proyecto sin compromiso. Ya sea una landing page para lanzar tu negocio, una web corporativa completa o una aplicación a medida, te asesoro con la mejor solución técnica.
          </p>

          <!-- Response speed guarantee -->
          <div class="mt-6 flex items-center gap-3 p-3.5 rounded-xl bg-slate-900/60 border border-white/5">
            <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
            <span class="text-xs text-slate-300">
              <strong>Disponibilidad inmediata:</strong> Respondo mensajes en menos de 24 horas.
            </span>
          </div>

          <!-- Direct Contact links -->
          <div class="mt-8 space-y-4">
            
            <!-- WhatsApp button -->
            <a 
              href={`https://wa.me/${siteConfig.whatsapp.replace(/\+/g, '').replace(/\s/g, '')}?text=${whatsappEncoded}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-4 rounded-xl bg-emerald-950/30 border border-emerald-500/30 hover:border-emerald-400 text-emerald-300 hover:text-white transition-all group"
            >
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-emerald-500/20 flex items-center justify-center text-emerald-400">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 012.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 01-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.64c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.98-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07s.89 2.4 1.01 2.57c.12.17 1.75 2.67 4.23 3.74.59.25 1.05.4 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.12-.23-.19-.48-.31z"/>
                  </svg>
                </div>
                <div>
                  <span class="block text-sm font-semibold text-white">Chatear por WhatsApp</span>
                  <span class="block text-xs text-slate-400">Mensaje directo instantáneo</span>
                </div>
              </div>
              <span class="text-xs font-mono text-emerald-400 group-hover:translate-x-1 transition-transform">Abrir chat →</span>
            </a>

            <!-- Email container with copy button -->
            <div class="flex items-center justify-between p-4 rounded-xl bg-slate-900/60 border border-white/5">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-cyan-500/10 flex items-center justify-center text-cyan-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <span class="block text-xs text-slate-400">Correo Electrónico</span>
                  <a href={`mailto:${siteConfig.email}`} class="text-sm font-medium text-white hover:text-cyan-400 transition-colors font-mono">
                    {siteConfig.email}
                  </a>
                </div>
              </div>
              
              <button 
                id="copy-email-btn"
                type="button"
                data-email={siteConfig.email}
                class="px-2.5 py-1 text-xs rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono transition-colors"
                title="Copiar correo"
              >
                Copiar
              </button>
            </div>

            <!-- Social links -->
            <div class="flex items-center gap-3 pt-2">
              <a 
                href={siteConfig.github} 
                target="_blank" 
                rel="noopener noreferrer"
                class="flex-1 flex items-center justify-center gap-2 p-3 rounded-xl bg-slate-900/60 border border-white/5 hover:border-white/20 text-xs font-semibold text-slate-300 hover:text-white transition-all"
              >
                <span>GitHub</span>
              </a>
              <a 
                href={siteConfig.linkedin} 
                target="_blank" 
                rel="noopener noreferrer"
                class="flex-1 flex items-center justify-center gap-2 p-3 rounded-xl bg-slate-900/60 border border-white/5 hover:border-white/20 text-xs font-semibold text-slate-300 hover:text-white transition-all"
              >
                <span>LinkedIn</span>
              </a>
            </div>

          </div>
        </div>

        <div class="mt-8 text-xs text-slate-500 font-mono">
          📍 {siteConfig.location}
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div class="lg:col-span-7">
        <div class="p-8 sm:p-10 rounded-3xl bg-slate-900/40 border border-white/10 relative shadow-2xl">
          <h3 class="text-xl font-bold text-white mb-2">Envíame un mensaje</h3>
          <p class="text-xs text-slate-400 mb-6">Cuéntame de tu proyecto, presupuesto estimado o consulta puntual.</p>

          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-medium text-slate-300 mb-1.5 font-mono">Tu Nombre *</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  placeholder="Ej: Juan Pérez"
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-400 transition-colors"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-medium text-slate-300 mb-1.5 font-mono">Tu Email *</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  placeholder="juan@ejemplo.com"
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-400 transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="service-type" class="block text-xs font-medium text-slate-300 mb-1.5 font-mono">¿Qué tipo de proyecto necesitas?</label>
              <select 
                id="service-type" 
                name="service-type"
                class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-white/10 text-white text-sm focus:outline-none focus:border-cyan-400 transition-colors"
              >
                <option value="Landing Page">Landing Page de Alta Conversión</option>
                <option value="Sitio Corporativo">Sitio Web Corporativo o Portfolio</option>
                <option value="E-commerce">Tienda Online / Catálogo Digital</option>
                <option value="Aplicacion Web">Aplicación Web / Panel Administrativo</option>
                <option value="Rediseño / Optimización">Rediseño o Aumento de Velocidad SEO</option>
                <option value="Consulta General">Consulta general o propuesta académica</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs font-medium text-slate-300 mb-1.5 font-mono">Detalles del mensaje *</label>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                required 
                placeholder="Cuéntame sobre tu negocio, qué funcionalidades buscas y plazos estimados..."
                class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-cyan-400 transition-colors resize-none"
              ></textarea>
            </div>

            <button 
              type="submit" 
              id="submit-btn"
              class="w-full py-3 px-6 rounded-xl font-semibold text-sm text-white bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 shadow-lg shadow-cyan-500/25 transition-all hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2"
            >
              <span>Enviar Consulta</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </form>

          <!-- Feedback message -->
          <div id="form-feedback" class="hidden mt-4 p-4 rounded-xl text-xs font-mono text-center"></div>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Copy email button logic
  const copyBtn = document.getElementById('copy-email-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email');
      if (email) {
        await navigator.clipboard.writeText(email);
        const originalText = copyBtn.textContent;
        copyBtn.textContent = '¡Copiado!';
        copyBtn.classList.add('bg-emerald-700', 'text-white');
        setTimeout(() => {
          copyBtn.textContent = originalText;
          copyBtn.classList.remove('bg-emerald-700', 'text-white');
        }, 2000);
      }
    });
  }

  // Simple client-side form submission handler (opens mailto or gives positive prompt)
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');

  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const email = formData.get('email') as string;
      const service = formData.get('service-type') as string;
      const message = formData.get('message') as string;

      // Construct mailto link as fallback to guarantee email delivery
      const mailtoSubject = encodeURIComponent(`Nuevo contacto web: ${service} - ${name}`);
      const mailtoBody = encodeURIComponent(`Nombre: ${name}\nEmail: ${email}\nServicio: ${service}\n\nMensaje:\n${message}`);
      
      feedback.classList.remove('hidden');
      feedback.classList.add('bg-emerald-950/60', 'text-emerald-300', 'border', 'border-emerald-500/30');
      feedback.innerHTML = `¡Gracias por tu mensaje, ${name}! Se está abriendo tu cliente de correo para confirmarlo. También puedes escribirme directamente por WhatsApp para una respuesta inmediata.`;

      // Open user's email client
      window.location.href = `mailto:tu-email@ejemplo.com?subject=${mailtoSubject}&body=${mailtoBody}`;
    });
  }
</script>
