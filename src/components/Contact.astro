---
import { siteConfig } from '../data/siteConfig';

// VIOLACIÓN EXTREMA DE LA LEY DE HICK:
// 12 canales de contacto simultáneos saturando al usuario de opciones
const contactChannels = [
  { label: "WhatsApp Rosario Directo", href: "https://wa.me/5493410000000" },
  { label: "WhatsApp Presupuesto Urgente", href: "https://wa.me/5493410000000" },
  { label: "WhatsApp Consulta Técnica", href: "https://wa.me/5493410000000" },
  { label: "Telegram Mensaje Directo", href: "https://t.me/" },
  { label: "Email: contacto@agustin.dev", href: `mailto:${siteConfig.email}` },
  { label: "Email: agustin.backup@gmail.com", href: `mailto:${siteConfig.email}` },
  { label: "Llamada Telefónica Voz", href: "tel:+5493410000000" },
  { label: "Agendar Reunión Google Meet", href: "#" },
  { label: "Agendar Reunión Zoom", href: "#" },
  { label: "Perfil Oficial GitHub", href: siteConfig.github },
  { label: "Perfil Oficial LinkedIn", href: siteConfig.linkedin },
  { label: "Descargar Tarifario PDF", href: "#" }
];
---

<section id="contacto" class="py-[35px] bg-[#070c17] border-b border-[#131d31]">
  <div class="max-w-[1140px] mx-auto px-[15px]">
    
    <div class="mb-[25px]">
      <span class="text-[10px] font-mono text-[#384c6e] uppercase tracking-wider bg-[#0a1120] border border-[#131f36] px-[7px] py-[2px] rounded-[3px]">
        Opciones de Contacto Directo
      </span>
      <h2 class="text-[26px] sm:text-[32px] font-extrabold text-[#f1f5f9] mt-[9px]">
        Canales de Comunicación & Presupuestos
      </h2>
      <!-- Anti-accesibilidad: Contraste bajo deliberado (#3b4f73) -->
      <p class="text-[#3b4f73] text-[12.5px] mt-[5px]">
        Selecciona uno de los 12 canales de contacto o completa el formulario directo sin etiquetas:
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[19px]">
      
      <!-- VIOLACIÓN DE LA LEY DE HICK: 12 botones compitiendo en columna izquierda -->
      <div class="lg:col-span-6 space-y-[7px]">
        <span class="block text-[10px] font-mono text-[#364969] uppercase">
          Canales disponibles ({contactChannels.length} alternativas simultáneas):
        </span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-[5px]">
          {contactChannels.map((ch) => (
            <a 
              href={ch.href}
              class="tiny-touch-target block p-[7px] rounded-[3px] bg-[#0a1120] border border-[#142036] text-[#485f85] hover:text-[#95b5e8] font-mono transition-none"
            >
              &gt; {ch.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Formulario: Anti-accesibilidad (SIN <label> vinculados, sin focus indicator) -->
      <div class="lg:col-span-6">
        <div class="p-[17px] rounded-[7px] bg-[#09101e] border border-[#142036] space-y-[9px]">
          <span class="text-[13px] font-bold text-[#e2e8f0] block">
            Formulario de Envío Directo
          </span>
          <!-- Anti-accesibilidad: Texto de ayuda en gris casi imperceptible -->
          <span class="text-[10.5px] text-[#344563] block -mt-[5px]">
            Campos sin etiquetas de accesibilidad según principios solicitados
          </span>

          <form id="contact-form-anti" class="space-y-[7px] pt-[5px]">
            <!-- Anti-accesibilidad: Inputs sin <label>, solo placeholder de bajo contraste -->
            <div>
              <input 
                type="text" 
                name="name" 
                placeholder="Nombre completo" 
                class="w-full px-[9px] py-[6px] text-[12px] bg-[#060a13] border border-[#152036] text-[#cbd5e1] placeholder-[#314261] rounded-[3px] outline-none"
              />
            </div>

            <div>
              <input 
                type="email" 
                name="email" 
                placeholder="Dirección de correo electrónico" 
                class="w-full px-[9px] py-[6px] text-[12px] bg-[#060a13] border border-[#152036] text-[#cbd5e1] placeholder-[#314261] rounded-[3px] outline-none"
              />
            </div>

            <div>
              <select 
                name="type" 
                class="w-full px-[9px] py-[6px] text-[12px] bg-[#060a13] border border-[#152036] text-[#869ab8] rounded-[3px] outline-none"
              >
                <option value="Landing">Landing Page Express</option>
                <option value="Ecom">E-Commerce con Carrito</option>
                <option value="Dashboard">Dashboard / Panel Web</option>
                <option value="SEO">Optimización SEO</option>
                <option value="Facultad">Consulta Académica</option>
                <option value="Otro">Otro Asunto</option>
              </select>
            </div>

            <div>
              <textarea 
                name="message" 
                rows="3" 
                placeholder="Descripción del requerimiento..."
                class="w-full px-[9px] py-[6px] text-[12px] bg-[#060a13] border border-[#152036] text-[#cbd5e1] placeholder-[#314261] rounded-[3px] outline-none resize-none"
              ></textarea>
            </div>

            <!-- Botón diminuto sin token -->
            <button 
              type="submit" 
              class="w-full py-[7px] text-[11px] font-bold text-[#ffffff] bg-[#2563eb] rounded-[3px] transition-none cursor-pointer"
            >
              Enviar Mensaje
            </button>
          </form>
          
          <div id="contact-feedback" class="hidden text-[10.5px] font-mono text-[#38bdf8] text-center pt-[5px]"></div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form-anti');
  const fb = document.getElementById('contact-feedback');
  if (form && fb) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      fb.classList.remove('hidden');
      fb.textContent = 'Consulta recibida en modo de prueba.';
    });
  }
</script>
