---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../data/siteConfig';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.pubDate).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout 
  title={`${post.data.title} | Blog de ${siteConfig.name}`} 
  description={post.data.description}
>
  <article class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Back to blog navigation -->
      <div class="mb-10">
        <a 
          href="/blog" 
          class="inline-flex items-center gap-2 text-xs font-mono text-cyan-400 hover:text-cyan-300 transition-colors"
        >
          <span>← Volver a todas las publicaciones</span>
        </a>
      </div>

      <!-- Post Header -->
      <header class="mb-12 pb-8 border-b border-white/10">
        <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-slate-400 mb-4">
          <span class="px-2.5 py-1 rounded-full bg-cyan-950/60 border border-cyan-500/20 text-cyan-300">
            {post.data.category}
          </span>
          <span>&middot;</span>
          <span>{post.data.readTime}</span>
          <span>&middot;</span>
          <time datetime={post.data.pubDate.toISOString()}>
            {formattedDate}
          </time>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-[1.2]">
          {post.data.title}
        </h1>

        <p class="text-slate-300 text-base sm:text-lg mt-4 leading-relaxed">
          {post.data.description}
        </p>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mt-6">
          {post.data.tags.map((tag) => (
            <span class="text-xs font-mono px-2.5 py-0.5 rounded bg-slate-900 border border-white/10 text-slate-400">
              #{tag}
            </span>
          ))}
        </div>
      </header>

      <!-- Post Markdown Content with customized typography -->
      <div class="prose-content text-slate-300 leading-relaxed space-y-6 text-base sm:text-lg font-normal">
        <Content />
      </div>

      <!-- Article Author & CTA Footer -->
      <div class="mt-16 pt-10 border-t border-white/10">
        <div class="p-8 rounded-2xl bg-slate-900/60 border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center font-bold text-white text-lg">
              {siteConfig.name.charAt(0)}
            </div>
            <div>
              <h4 class="text-base font-bold text-white">{siteConfig.name}</h4>
              <p class="text-xs text-slate-400">{siteConfig.role}</p>
            </div>
          </div>

          <div class="flex items-center gap-3 w-full sm:w-auto">
            <a 
              href="/#contacto" 
              class="w-full sm:w-auto text-center px-4 py-2 text-xs font-semibold text-white bg-cyan-600 hover:bg-cyan-500 rounded-lg transition-colors shadow-sm"
            >
              Contactar al Autor
            </a>
            <a 
              href="/blog" 
              class="w-full sm:w-auto text-center px-4 py-2 text-xs font-medium text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 rounded-lg transition-colors"
            >
              Más Artículos
            </a>
          </div>
        </div>
      </div>

    </div>
  </article>
</Layout>

<style is:global>
  /* Markdown Content Styling */
  .prose-content h2 {
    font-size: 1.75rem;
    font-weight: 800;
    color: #ffffff;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.025em;
  }
  .prose-content h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #f1f5f9;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose-content p {
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }
  .prose-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
    space-y: 0.5rem;
  }
  .prose-content ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .prose-content li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  .prose-content blockquote {
    border-left: 3px solid #38bdf8;
    padding-left: 1rem;
    font-style: italic;
    color: #94a3b8;
    margin: 1.5rem 0;
  }
  .prose-content strong {
    color: #ffffff;
    font-weight: 600;
  }
  .prose-content code {
    background: #1e293b;
    color: #38bdf8;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875em;
    padding: 0.2rem 0.4rem;
    border-radius: 0.375rem;
  }
  .prose-content pre {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.25rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .prose-content pre code {
    background: transparent;
    padding: 0;
    color: #e2e8f0;
  }
</style>
