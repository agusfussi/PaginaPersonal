---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../data/siteConfig';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ["Todos", "Facultad & Aprendizaje", "Desarrollo Web & Negocios", "Historia & Vocación", "Tecnología & Arquitectura"];
---

<Layout 
  title={`Blog & Bitácora | ${siteConfig.name}`} 
  description="Artículos sobre desarrollo de páginas web, experiencias en la facultad, proyectos de software y buenas prácticas."
>
  <div class="py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Blog Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <a href="/" class="inline-flex items-center gap-1.5 text-xs font-mono text-cyan-400 hover:text-cyan-300 mb-4 transition-colors">
          <span>← Volver al Portfolio</span>
        </a>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
          Blog & Bitácora Profesional
        </h1>
        <p class="text-slate-300 text-base sm:text-lg mt-4 leading-relaxed">
          Publicaciones sobre desarrollo web, proyectos reales, reflexiones de la facultad y aprendizajes en mi trayectoria formativa.
        </p>

        <!-- Category Filters -->
        <div class="flex flex-wrap items-center justify-center gap-2 mt-8" id="blog-filters">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-category={cat}
              class={`blog-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-medium transition-all ${
                idx === 0 
                  ? 'bg-cyan-500 text-white shadow-sm shadow-cyan-500/30' 
                  : 'bg-slate-900/80 text-slate-400 hover:text-white border border-white/5 hover:border-white/20'
              }`}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="blog-posts-container">
        {sortedPosts.map((post) => (
          <article 
            class="blog-post-card group rounded-2xl bg-slate-900/40 border border-white/5 hover:border-cyan-500/30 p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-cyan-950/20 flex flex-col justify-between"
            data-post-category={post.data.category}
          >
            <div>
              <!-- Meta tags: category + reading time -->
              <div class="flex items-center justify-between text-xs text-slate-400 font-mono mb-4">
                <span class="px-2.5 py-1 rounded bg-slate-800 text-cyan-300 border border-white/5">
                  {post.data.category}
                </span>
                <span>{post.data.readTime}</span>
              </div>

              <!-- Title -->
              <h2 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors leading-snug">
                <a href={`/blog/${post.id}/`}>
                  {post.data.title}
                </a>
              </h2>

              <!-- Description -->
              <p class="text-slate-300 text-sm mt-3 leading-relaxed">
                {post.data.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-1.5 mt-4">
                {post.data.tags.map((tag) => (
                  <span class="text-[11px] font-mono text-slate-400 bg-slate-800/60 px-2 py-0.5 rounded">
                    #{tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Card Bottom Date and Link -->
            <div class="mt-8 pt-4 border-t border-white/5 flex items-center justify-between text-xs">
              <span class="text-slate-500 font-mono">
                {new Date(post.data.pubDate).toLocaleDateString('es-ES', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </span>
              <a 
                href={`/blog/${post.id}/`} 
                class="inline-flex items-center gap-1 font-semibold text-cyan-400 group-hover:translate-x-1 transition-transform"
              >
                <span>Leer artículo</span>
                <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Add Post Instruction callout for the user -->
      <div class="mt-16 p-6 rounded-2xl bg-slate-900/30 border border-white/5 text-center max-w-xl mx-auto">
        <span class="text-xs font-mono text-cyan-400">💡 ¿Quieres publicar un nuevo artículo?</span>
        <p class="text-xs text-slate-400 mt-2">
          Solo crea un nuevo archivo <code class="text-slate-200 bg-slate-800 px-1 py-0.5 rounded">.md</code> en <code class="text-slate-200 bg-slate-800 px-1 py-0.5 rounded">src/content/blog/</code> y aparecerá aquí automáticamente.
        </p>
      </div>

    </div>
  </div>
</Layout>

<script>
  const filterBtns = document.querySelectorAll('.blog-filter-btn');
  const postCards = document.querySelectorAll('.blog-post-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-cyan-500', 'text-white', 'shadow-sm', 'shadow-cyan-500/30');
        b.classList.add('bg-slate-900/80', 'text-slate-400');
      });
      btn.classList.add('bg-cyan-500', 'text-white', 'shadow-sm', 'shadow-cyan-500/30');
      btn.classList.remove('bg-slate-900/80', 'text-slate-400');

      const selectedCategory = btn.getAttribute('data-category');

      postCards.forEach(card => {
        const cardCategory = card.getAttribute('data-post-category');
        if (selectedCategory === 'Todos' || cardCategory === selectedCategory) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
